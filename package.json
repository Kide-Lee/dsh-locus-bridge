{
  "name": "dsh-locus-bridge",
  "version": "0.1.0",
  "description": "DSH plugin acting as a Locus client for the Unity native broker (Win32 named pipe or Unix domain socket).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "native/locus_unix_native/Cargo.toml",
    "native/locus_unix_native/Cargo.lock",
    "native/locus_unix_native/src",
    "native/locus_unix_native/tests",
    "native/locus-native-protocol/Cargo.toml",
    "native/locus-native-protocol/Cargo.lock",
    "native/locus-native-protocol/src"
  ],
  "engines": {
    "node": ">=22.12",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kide-Lee/dsh-locus-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Kide-Lee/dsh-locus-bridge/issues"
  },
  "homepage": "https://github.com/Kide-Lee/dsh-locus-bridge#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "unity",
    "unity-editor",
    "locus",
    "game-development",
    "csharp"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:live": "node scripts/live-smoke.mjs",
    "dump-tools": "node scripts/dump-tools.mjs",
    "verify-schema": "node scripts/verify-dsh-schema.mjs",
    "validate": "node scripts/dump-tools.mjs && node scripts/typecheck.mjs && node scripts/validate-dsh-tools.mjs && node scripts/build-client.mjs --check && node scripts/build-model-viewer.mjs --check",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "node --test --test-concurrency=1 \"test/*.test.js\" && node scripts/dump-tools.mjs && node scripts/typecheck.mjs && node scripts/build-client.mjs --check && node scripts/build-model-viewer.mjs --check",
    "build:native": "cargo build --release --manifest-path native/locus_unix_native/Cargo.toml",
    "test:native": "cargo test --release --manifest-path native/locus_unix_native/Cargo.toml",
    "sync:payload": "node scripts/sync-payload.mjs",
    "check:payload": "node scripts/sync-payload.mjs --check",
    "install:unity-package": "node scripts/install-unity-package.mjs",
    "test:csharp": "node scripts/live-csharp.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "build:viewer": "node scripts/build-model-viewer.mjs",
    "check:viewer": "node scripts/build-model-viewer.mjs --check",
    "test:live:sidebar": "node scripts/live-sidebar.mjs",
    "test:live:render": "node scripts/live-render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.185.1"
  }
}
