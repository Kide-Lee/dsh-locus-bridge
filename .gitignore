# Locus broker runtime objects created inside the workspace: the Unix socket
# cannot live in /tmp under the sandbox (a fresh tmpfs per command), so it is
# bound here; it is a socket, never a tracked artifact.
.locus/

# DSH / Node tooling
node_modules/
.tmp/
.npm-cache/

# The Unity test project is a disposable fixture: it is created locally by
# `scripts/live-smoke` setup and must never be version-controlled from here.
unity-test/
unity-test/**

# Unity editor / Locus runtime state — never tracked even if the parent repo is
# initialised later (Library/ holds the Locus edit-session primitives Unity's
# Linux named-mutex emulation creates, user settings, caches).
unity-test/Library/
unity-test/Temp/
unity-test/Obj/
unity-test/Logs/
unity-test/UserSettings/
unity-test/MemoryCaptures/
unity-test/.vs/
unity-test/.idea/
unity-test/.vscode/
unity-test/*.csproj
unity-test/*.sln
unity-test/*.unityproj
unity-test/*.suo
unity-test/*.user
unity-test/*.pidb
unity-test/*.booproj
unity-test/*.svd
unity-test/*.pdb
unity-test/*.mdb
unity-test/*.opendb
unity-test/*.VC.db
unity-test/[Ll]ibrary/
unity-test/[Tt]emp/
unity-test/[Oo]bj/
unity-test/[Bb]uild/
unity-test/[Bb]uilds/
unity-test/[Ll]ogs/
unity-test/[Uu]ser[Ss]ettings/
unity-test/[Mm]emoryCaptures/

# Upstream Locus checkout is a separate git repository (kept as-is)
Locus/

.DS_Store
Thumbs.db

# Rust build output for the vendored Unix broker port (the sources are tracked,
# the artifacts are not: `npm run build:native` rebuilds them).
native/**/target/

# Local Rust toolchain (installed into the workspace)
.tooling/

# Release assets staged locally for a manual GitHub upload: a tarball of the
# payload tree plus standalone copies of the two brokers. Build output only —
# dist/ is regenerated, never committed. The payload tree itself stays tracked
# under payload/, which is what makes `dsh plugin add github:…` self-contained.
dist/
